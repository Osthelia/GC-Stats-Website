# Copy to `.env` (same directory as docker-compose.yml) and fill in.
# `.env` is git-ignored, never commit real secrets.

# --- Bundled Postgres (the `db` service) ---
# Leave as-is for a self-contained `docker compose up`. To point at an
# external database instead (prod: self-hosted PG on Infomaniak Public
# Cloud), set DATABASE_URL below directly. It overrides the POSTGRES_*
# composed default and the `db` service will simply go unused (still fine
# to leave it running).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gcstats_v2
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

WEB_PORT=3000

# Public base URL of the site, no trailing slash (see apps/web/src/app/sitemap.ts).
SITE_URL=http://localhost:3000

# --- Auth.js (see apps/web/src/auth.ts) ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth apps, leave empty to disable a provider, it just won't show up.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Object storage (see packages/storage), S3-compatible (R2/OVH/Backblaze/MinIO/AWS) ---
# Logo/media uploads fail until these are filled in.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# --- Forum automod (see apps/web/src/lib/openai-moderation.ts) ---
# Leave empty to disable automod: forum posts are then never auto-flagged
# (fails open), everything else keeps working.
OPENAI_API_KEY=

# --- Scheduled jobs (see apps/web/src/lib/scheduled-jobs) ---
# Leave empty to skip the "match/tournament went live" Discord notification,
# the status flip itself still happens.
DISCORD_MATCH_LIVE_WEBHOOK_URL=

# --- Riot Valorant relay (I:\...\RiotRelay, separate deployed service) ---
# Caches/relays the official Riot match-v1 API for a map's "Fetch"/"Renew"/
# "Merge" (see apps/web/src/lib/riot-relay-client.ts). Leave empty: those
# admin actions return a clear "not configured" error, everything else
# (manual map/stat entry) keeps working.
RIOT_RELAY_URL=
RIOT_RELAY_TOKEN=

# --- Riot's own official content API (val/content/v1/contents), distinct
# from the relay above — resolves map/agent/weapon/armor UUIDs to display
# names (see apps/web/src/lib/riot-content-client.ts). Leave empty: raw
# Riot UUIDs are stored/shown instead of names (fails open, cached 1 day
# once set).
RIOT_KEY=

# --- Transactional email (Resend, see apps/web/src/lib/email) ---
# Leave RESEND_API_KEY empty to disable: in-app notifications keep working,
# only the opt-in email copy is skipped (fails open).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@gc-stats.gg

# --- Discord DM notifications (Osthelia-DiscordNotificationsWorker, shared
# across services) ---
# DISCORD_GUILD_ID: server users must join to receive DMs (bot needs a
# mutual server). DISCORD_INVITE_URL: shown on /settings/account when a
# linked user hasn't joined yet.
# On Cloudflare, the Worker itself is reached through the DISCORD_NOTIFICATIONS
# Service Binding (wrangler.jsonc), not a URL — it has no public workers.dev
# URL. DISCORD_NOTIFICATIONS_WORKER_URL only applies to the self-hosted
# Docker deploy. DISCORD_NOTIFICATIONS_WORKER_KEY is needed in both cases
# (one of the Worker's SERVICE_KEYS, registered under "gc-stats"). Leave it
# empty to disable: only the opt-in Discord DM copy is skipped (fails open).
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
DISCORD_NOTIFICATIONS_WORKER_URL=
DISCORD_NOTIFICATIONS_WORKER_KEY=
