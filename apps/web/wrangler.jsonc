{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gc-stats-web",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gcs-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a47df1aacaaf46399507f2dd5cd32847"
    },
    {
      // Same Neon database as HYPERDRIVE, caching disabled — used by
      // packages/db/src/client.ts's `adminDb` for admin/dashboard reads that
      // must reflect a write made moments earlier.
      "binding": "HYPERDRIVE_ADMIN",
      "id": "2a5a163febd24c0ea6392872f115b8f1"
    }
  ],
  "vpc_services": [
    {
      "binding": "RIOT_RELAY",
      "service_id": "01a0e3ed-56fb-7691-a6f5-39c2c693c47d"
    }
  ],
  "services": [
    {
      "binding": "DISCORD_NOTIFICATIONS",
      "service": "discord-notifications-worker"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "5 0 1 * *", "10 0 1 * *", "0 0 * * *", "* * * * *"]
  },
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "AUTH_TRUST_HOST": true,
    "AUTH_URL": "https://gc-stats.app",
    "SITE_URL": "https://gc-stats.app",
    "S3_REGION": "auto",
    "S3_PUBLIC_URL": "https://cdn.gc-stats.app",
    "S3_FORCE_PATH_STYLE": true,
    "DISCORD_GUILD_ID": "1497392646958747858",
    "DISCORD_INVITE_URL": "https://discord.gg/kFHNN8cDXJ",
    "NEXT_PUBLIC_WIDGETS_URL": "https://widgets.osthelia.org"
  },
  "env": {
    "preview": {
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2f03e3c092f24c839990cf5db0b629d6"
        },
        {
          "binding": "HYPERDRIVE_ADMIN",
          "id": "aed2896219d14ae2a8dd1d9b6344cd4b"
        }
      ],
      "vpc_services": [
        {
          "binding": "RIOT_RELAY",
          "service_id": "01a0e3ed-56fb-7691-a6f5-39c2c693c47d"
        }
      ],
      "services": [
        {
          "binding": "DISCORD_NOTIFICATIONS",
          "service": "discord-notifications-worker"
        }
      ],
      "vars": {
        "DEPLOY_TARGET": "cloudflare",
        "AUTH_TRUST_HOST": true,
        "SITE_URL": "https://gc-stats.app",
        "S3_REGION": "auto",
        "S3_PUBLIC_URL": "https://cdn.gc-stats.app",
        "S3_FORCE_PATH_STYLE": true,
        "NEXT_PUBLIC_WIDGETS_URL": "https://widgets.osthelia.org"
      }
    }
  },
  "limits": {
    "cpu_ms": 60000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false,
      "destinations": [
        "osthelia-logs"
      ],
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.01,
      "destinations": [
        "osthelia-traces"
      ],
      "persist": true
    }
  }
}
