# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/gcstats_v2

# --- Auth.js (see src/auth.ts) ---
# Generate with `openssl rand -base64 32`
AUTH_SECRET=

# --- OAuth providers (leave empty to disable a provider) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Object storage (see packages/storage) — S3 compatible (R2/OVH/Backblaze/MinIO/AWS) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# --- Forum automod (see src/lib/openai-moderation.ts) ---
# Empty until set, automod fails open (never flags) without it.
OPENAI_API_KEY=

# --- Riot relay / API ---
RIOT_RELAY_URL=http://127.0.0.1:4000
RIOT_RELAY_TOKEN=
RIOT_KEY=

# --- Email (see src/lib/email/client.ts) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Discord notifications ---
DISCORD_MATCH_LIVE_WEBHOOK_URL=

# --- Site ---
SITE_URL=http://localhost:3000

# --- Deploy ---
# "local" | "preview" | "production" (see src/instrumentation.ts, src/lib/*throttle*)
DEPLOY_TARGET=local

# --- Cron (see custom-worker.ts, src/app/api/internal/cron/route.ts) ---
# Generate with `openssl rand -base64 32`. On Cloudflare, set with `wrangler secret put CRON_SECRET`.
CRON_SECRET=

# Docker only: number of reverse proxies in front of the app that append to X-Forwarded-For (default 1).
# Ignored on Cloudflare, which uses cf-connecting-ip.
TRUSTED_PROXY_COUNT=1
