# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/gcstats_v2

# --- Auth.js (see src/auth.ts) ---
# Generate with `openssl rand -base64 32`
AUTH_SECRET=

# --- OAuth providers (leave empty to disable a provider) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Object storage (see packages/storage) — S3 compatible (R2/OVH/Backblaze/MinIO/AWS) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# --- Forum automod (see src/lib/openai-moderation.ts) ---
# Empty until set, automod fails open (never flags) without it.
OPENAI_API_KEY=

# --- Riot relay / API ---
RIOT_RELAY_URL=http://127.0.0.1:4000
RIOT_RELAY_TOKEN=
RIOT_KEY=

# --- Email (see src/lib/email/client.ts) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Discord notifications ---
DISCORD_MATCH_LIVE_WEBHOOK_URL=
# Discord webhook alerted when the OpenData portal is throttled or shed to protect the site. Empty = no alert.
DISCORD_OPENDATA_ALERT_WEBHOOK_URL=

# --- Site ---
SITE_URL=http://localhost:3000

# --- Runtime ---
# Max connections of the pg pool of one process (default: pg's own, 10). In the cluster: replicas x this value
# must stay under the PgBouncer limit.
DATABASE_POOL_SIZE=10
# Separate pool of the OpenData portal (default 2), so its queries never take a connection from the site.
OPENDATA_DATABASE_POOL_SIZE=2

# --- Cron (see src/instrumentation.ts, src/app/api/internal/cron/route.ts) ---
# Scheduled jobs: "true" starts them inside this process (local dev, a single process). In the cluster it stays
# unset: Kubernetes CronJobs call POST /api/internal/cron with the bearer token below, once per tick.
ENABLE_IN_PROCESS_SCHEDULER=true
# Generate with `openssl rand -base64 32`.
CRON_SECRET=

# --- Proxy / visitor ---
# Number of reverse proxies in front of the app that append to X-Forwarded-For (default 1).
TRUSTED_PROXY_COUNT=1

# --- Widgets front (separate repo, see Widgets/README.md) ---
# Public URL where the widgets are hosted, used to build the links in /widget.
NEXT_PUBLIC_WIDGETS_URL=https://widgets.osthelia.org

# Build-time only (Docker build arg): CDN host for /_next/static, e.g. https://static.gc-stats.app. Leave empty to serve assets from the app.
# ASSET_PREFIX=
