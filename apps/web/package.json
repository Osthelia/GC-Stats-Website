    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.147.0",
    "zod": "^4.6.5"
