{
  "name": "@gc-stats/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "npm run cf-build && opennextjs-cloudflare preview",
    "deploy": "npm run cf-build && opennextjs-cloudflare deploy",
    "upload": "npm run cf-build && opennextjs-cloudflare upload",
    "cf-build": "npm run cf-typegen && cross-env OPENNEXT_BUILD_TARGET=cloudflare opennextjs-cloudflare build && node scripts/copy-messages-assets.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.8.0",
